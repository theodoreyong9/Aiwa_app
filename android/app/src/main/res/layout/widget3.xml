<?xml version="1.0" encoding="utf-8"?>
<!-- The third widget (written by hand): ONE row of tiles, in the look of the second widget: Oreille, Wallet, Search and, only when there is an update, Mise à jour. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<FrameLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_gravity="center_vertical" android:background="@drawable/w2_bg" android:clipToOutline="true">
<ImageView android:id="@+id/w3_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
<FrameLayout android:id="@+id/w3_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w2_scrim" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="2dp">
<FrameLayout android:id="@+id/w3_c_ear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/w2_g_ear_a" android:clipToOutline="true"><ImageView android:id="@+id/w3_i_ear" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|top" android:layout_marginEnd="-8dp" android:layout_marginTop="-4dp" android:src="@drawable/fw_i_ear" /><TextView android:id="@+id/w3_t_ear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|bottom" android:layout_marginStart="8dp" android:layout_marginBottom="4dp" android:text="Oreille" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" /></FrameLayout>
<FrameLayout android:id="@+id/w3_c_wallet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/w2_g_wallet_b" android:clipToOutline="true"><ImageView android:id="@+id/w3_i_wallet" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|top" android:layout_marginEnd="-8dp" android:layout_marginTop="-4dp" android:src="@drawable/fw_i_wallet" /><TextView android:id="@+id/w3_t_wallet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|bottom" android:layout_marginStart="8dp" android:layout_marginBottom="4dp" android:text="Wallet" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" /></FrameLayout>
<FrameLayout android:id="@+id/w3_c_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/w2_g_search_a" android:clipToOutline="true"><ImageView android:id="@+id/w3_i_search" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|top" android:layout_marginEnd="-8dp" android:layout_marginTop="-4dp" android:src="@drawable/fw_i_link" /><TextView android:id="@+id/w3_t_search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|bottom" android:layout_marginStart="8dp" android:layout_marginBottom="4dp" android:text="Search" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" /></FrameLayout>
<FrameLayout android:id="@+id/w3_c_update" android:visibility="gone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/w2_g_files_a" android:clipToOutline="true"><ImageView android:id="@+id/w3_i_update" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|top" android:layout_marginEnd="-8dp" android:layout_marginTop="-4dp" android:src="@drawable/fw_i_update" /><TextView android:id="@+id/w3_t_update" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|bottom" android:layout_marginStart="8dp" android:layout_marginBottom="4dp" android:text="Mise à jour" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" /></FrameLayout>
</LinearLayout>
</FrameLayout>
</FrameLayout>
