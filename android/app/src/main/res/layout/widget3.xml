<?xml version="1.0" encoding="utf-8"?>
<!-- The third widget (written by hand): ONE row with no background at all. Each button: its name at the left, a big coloured icon at the right: Question, Oreille, Ajouter and Swipe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp">
<LinearLayout android:id="@+id/w3_c_question" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_question" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Question" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_question" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_question" /></LinearLayout>
<LinearLayout android:id="@+id/w3_c_ear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_ear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Oreille" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_ear" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_ear" /></LinearLayout>
<LinearLayout android:id="@+id/w3_c_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_add" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ajouter" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_add" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_plus" /></LinearLayout>
<LinearLayout android:id="@+id/w3_c_swipe" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_swipe" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Swipe" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_swipe" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_pin" /></LinearLayout>
</LinearLayout>
