<?xml version="1.0" encoding="utf-8"?>
<!-- The third widget (written by hand): ONE row with no background at all. Each button: its name at the left, a big coloured icon at the right: Oreille, Wallet, Search and, only when there is an update, Mise à jour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp">
<LinearLayout android:id="@+id/w3_c_ear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_ear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Oreille" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_ear" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_ear" /></LinearLayout>
<LinearLayout android:id="@+id/w3_c_wallet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_wallet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wallet" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_wallet" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_wallet" /></LinearLayout>
<LinearLayout android:id="@+id/w3_c_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_search" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Search" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_search" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_link" /></LinearLayout>
<LinearLayout android:id="@+id/w3_c_update" android:visibility="gone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/w3_t_update" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mise à jour" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:shadowColor="#B3000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1" /><ImageView android:id="@+id/w3_i_update" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="4dp" android:src="@drawable/fw_i_update" /></LinearLayout>
</LinearLayout>
