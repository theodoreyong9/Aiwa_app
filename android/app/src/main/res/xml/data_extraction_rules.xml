<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's automatic backup (Google Drive, and the phone-to-phone transfer) takes of this app: everything of the app's
  own storage, which includes the WebView's — where the wallet's journal lives (IndexedDB). A person who changes phone and types
  their 12 words finds the history there, with no server of ours.

  Not the secrets (SecretStore): they are encrypted with a Keystore key that does not move to another phone, so a copy would
  be worth nothing there. The 12 words are what carries the key over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aiwa_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aiwa_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
