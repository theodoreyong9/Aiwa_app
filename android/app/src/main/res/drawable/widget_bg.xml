<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card: a diagonal gradient (blue to violet), a sheen on top and a light edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><gradient android:angle="315" android:startColor="#1D2F66" android:endColor="#6A2C8A" /><corners android:radius="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#4DFFFFFF" android:centerColor="#0DFFFFFF" android:centerY="0.45" android:endColor="#00FFFFFF" /><corners android:radius="26dp" /><stroke android:width="1dp" android:color="#47FFFFFF" /></shape></item>
</layer-list>
